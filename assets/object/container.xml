<mujoco model="bowl_container">
  <!-- 简易碗：底面圆盘 + 一圈薄壁（开口朝上） -->
  <default>
    <default class="bowl">
      <geom friction="1.2 0.005 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"
            condim="3" density="350" rgba="0.82 0.72 0.55 1"
            contype="4" conaffinity="15"/>
    </default>
  </default>

  <worldbody>
    <!-- 碗底贴地；内径约 8cm，壁高约 3.5cm -->
