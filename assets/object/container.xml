      <freejoint name="bowl_free"/>
      <!-- 底 -->
      <geom name="bowl_bottom" type="cylinder" size="0.042 0.003" pos="0 0 0.003"/>
      <!-- 壁：12 段薄板围成圆筒 -->
      <geom name="bowl_w0"  type="box" size="0.006 0.012 0.02" pos="0.045 0 0.0205"/>
      <geom name="bowl_w1"  type="box" size="0.006 0.012 0.02" pos="0.03897 0.0225 0.0205" euler="0 0 0.5236"/>
      <geom name="bowl_w2"  type="box" size="0.006 0.012 0.02" pos="0.0225 0.03897 0.0205" euler="0 0 1.0472"/>
      <geom name="bowl_w3"  type="box" size="0.006 0.012 0.02" pos="0 0.045 0.0205" euler="0 0 1.5708"/>
      <geom name="bowl_w4"  type="box" size="0.006 0.012 0.02" pos="-0.0225 0.03897 0.0205" euler="0 0 2.0944"/>
