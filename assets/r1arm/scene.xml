<mujoco model="r1arm_scene">
  <!-- R1 7-DoF 单臂 MuJoCo 场景：从 URDF 几何/惯量移植 -->
  <compiler angle="radian" meshdir="meshes" autolimits="true" balanceinertia="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="arm_base" rgba="0.79216 0.81961 0.93333 1"/>
    <material name="arm_link" rgba="0.69804 0.69804 0.69804 1"/>

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="Link1" file="Link1.STL"/>
    <mesh name="Link2" file="Link2.STL"/>
    <mesh name="Link3" file="Link3.STL"/>
    <mesh name="Link4" file="Link4.STL"/>
    <mesh name="Link5" file="Link5.STL"/>
    <mesh name="Link6" file="Link6.STL"/>
    <mesh name="Link7" file="Link7.STL"/>
  </asset>

  <default>
    <default class="arm">
      <joint damping="1.0" armature="0.01"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1"/>
      <position kp="200" dampratio="1" forcerange="-80 80"/>
    </default>
  </default>

  <worldbody>
    <light pos="1.5 0 2.5" dir="-0.4 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <camera name="front" pos="0.9 -0.9 0.7" xyaxes="0.7 0.7 0 -0.35 0.35 0.87" fovy="50"/>
    <camera name="side" pos="1.2 0 0.55" xyaxes="0 1 0 -0.35 0 0.94" fovy="50"/>

    <!-- 基座固定于世界；URDF origin 已相对 base_link -->
    <body name="base_link" pos="0 0 0.0" childclass="arm">
      <geom mesh="base_link" material="arm_base"/>
      <inertial pos="-0.00010643 0.0010041 0.023203" mass="1.7759"
                fullinertia="0.0014112 0.001783 0.0025584 1.7968e-06 1.2255e-06 -8.2296e-06"/>

      <body name="Link1" pos="0 0 0.069">
        <joint name="J1" type="hinge" axis="0 0 -1" range="-2.723 2.723"/>
        <geom mesh="Link1" material="arm_link"/>
        <inertial pos="2.156e-08 -9.6233e-09 0.045314" mass="0.89452"
                  fullinertia="0.00082526 0.0006531 0.00059909 1.1484e-09 -7.1331e-10 5.9698e-10"/>

        <body name="Link2" pos="0 0 0.0469">
          <joint name="J2" type="hinge" axis="1 0 0" range="0 3.1416"/>
          <geom mesh="Link2" material="arm_link"/>
          <inertial pos="0.0017013 0.063321 -0.0042531" mass="0.74773"
                    fullinertia="0.001137 0.000672 0.001314 9.3e-05 -6e-06 3.2e-05"/>

          <body name="Link3" pos="0 0.1085 -0.0047926">
            <joint name="J3" type="hinge" axis="0 1 0" range="-0.349 3.491"/>
            <geom mesh="Link3" material="arm_link"/>
            <inertial pos="-0.0062069 0.075751 0.012556" mass="0.71845"
                      fullinertia="0.000746 0.000558 0.000728 2.9e-05 1.3e-05 -0.000086"/>

            <body name="Link4" pos="0.025 0.082408 0.016191">
              <joint name="J4" type="hinge" axis="1 0 0" range="-3.1415 0"/>
              <geom mesh="Link4" material="arm_link"/>
              <inertial pos="-0.020915 -0.070455 0.060056" mass="0.85572"
                        fullinertia="0.001009 0.000707 0.00093 -8.4e-05 6.3e-05 0.000139"/>

              <body name="Link5" pos="-0.022314 -0.10786 0.062877" quat="0.9999619  -0.0087265 0 0">
                <joint name="J5" type="hinge" axis="0 1 0" range="-2.269 2.269"/>
                <geom mesh="Link5" material="arm_link"/>
                <inertial pos="0.00042498 -0.043121 0.00020709" mass="0.59294"
                          fullinertia="0.000506 0.000349 0.000501 2e-06 -1e-06 -1e-06"/>

                <body name="Link6" pos="-1.1462e-05 -0.1072 0.00069991" quat="0.9999665 0 -0.0081873 0">
                  <joint name="J6" type="hinge" axis="-1 0 0" range="-0.524 0.524"/>
                  <geom mesh="Link6" material="arm_link"/>
                  <inertial pos="-1.3033e-07 -0.0098039 8.3267e-17" mass="0.391"
                            fullinertia="0.00014242 0.00014737 0.00015188 0 0 0"/>

                  <body name="Link7" pos="0 -0.01 0" quat="0 0 1 0">
                    <joint name="J7" type="hinge" axis="0 0 -1" range="-1.571 1.571"/>
                    <geom mesh="Link7" material="arm_link"/>
                    <inertial pos="-3.7143e-07 -0.018577 0.00595" mass="0.1048"
                              fullinertia="0.000105 7.3e-05 6.7e-05 0 0 0"/>
                    <site name="ee" pos="0 0 0" size="0.01" rgba="1 0.2 0.2 0.8"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position class="arm" name="act_J1" joint="J1"/>
    <position class="arm" name="act_J2" joint="J2"/>
    <position class="arm" name="act_J3" joint="J3"/>
    <position class="arm" name="act_J4" joint="J4"/>
    <position class="arm" name="act_J5" joint="J5"/>
    <position class="arm" name="act_J6" joint="J6"/>
    <position class="arm" name="act_J7" joint="J7"/>
  </actuator>

  <keyframe>
    <!-- 与 robot/r1arm_config.ARM_INIT 对齐 -->
    <key name="home" qpos="0 1.2 0 -1.2 0 0 0" ctrl="0 1.2 0 -1.2 0 0 0"/>
  </keyframe>
</mujoco>
