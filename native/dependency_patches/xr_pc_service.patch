+void FeedbackController::enqueueDeviceMessage(QString devid, int type, QByteArray msgbody)
+{
+    if (type != PXREAServerMsgDeviceStateJson) {
+        QMetaObject::invokeMethod(this, [this, devid, type, msgbody] {
+            onReplyDeviceMessage(devid, type, msgbody);
+        }, Qt::QueuedConnection);
+        return;
+    }
+    if (m_latestStates.put(devid.toStdString(), std::string(msgbody.constData(), msgbody.size()))) {
+        QMetaObject::invokeMethod(this, [this] {
+            // take() releases its lock before the potentially blocking gRPC Write.
+            for (const auto& item : m_latestStates.take()) {
+                onReplyDeviceMessage(QString::fromStdString(item.first), PXREAServerMsgDeviceStateJson,
+                                     QByteArray(item.second.data(), static_cast<int>(item.second.size())));
+            }
+        }, Qt::QueuedConnection);
+    }
+}
