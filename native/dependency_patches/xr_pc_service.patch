diff --git a/RoboticsService/PXREAGRPCServer/LatestFrameMailbox.h b/RoboticsService/PXREAGRPCServer/LatestFrameMailbox.h
new file mode 100644
index 0000000..523a021
--- /dev/null
+++ b/RoboticsService/PXREAGRPCServer/LatestFrameMailbox.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+// State snapshots replace pending snapshots; commands must never enter this mailbox.
+class LatestFrameMailbox {
+public:
+    bool put(std::string device, std::string payload) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (pending_.count(device)) ++superseded_;
+        pending_[std::move(device)] = std::move(payload);
+        const bool schedule = !scheduled_;
+        scheduled_ = true;
+        return schedule;
+    }
+    std::unordered_map<std::string, std::string> take() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        std::unordered_map<std::string, std::string> result;
+        result.swap(pending_);
+        scheduled_ = false;
+        return result;
+    }
+    uint64_t superseded() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return superseded_;
+    }
+private:
+    mutable std::mutex mutex_;
+    std::unordered_map<std::string, std::string> pending_;
+    bool scheduled_{false};
+    uint64_t superseded_{0};
+};
