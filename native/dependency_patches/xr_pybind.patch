+pybind11::object getFrameSnapshot() {
+    const auto frame = frameCache.latest();
+    if (!frame) return pybind11::none();
+    pybind11::dict poses, keys, buttons, result;
+    poses["headset"] = frame->headset;
+    poses["left_controller"] = frame->left;
+    poses["right_controller"] = frame->right;
+    keys["left_grip"] = frame->keys[0]; keys["left_trigger"] = frame->keys[1];
+    keys["right_grip"] = frame->keys[2]; keys["right_trigger"] = frame->keys[3];
+    buttons["X"] = frame->buttons[0]; buttons["Y"] = frame->buttons[1];
+    buttons["A"] = frame->buttons[2]; buttons["B"] = frame->buttons[3];
+    result["poses"] = poses; result["keys"] = keys; result["buttons"] = buttons;
+    result["source_stamp_ns"] = frame->source_stamp_ns;
+    result["received_monotonic_ns"] = frame->received_monotonic_ns;
+    result["published_monotonic_ns"] = frame->published_monotonic_ns;
+    result["sequence"] = frame->sequence;
+    result["payload_hash"] = frame->payload_hash;
+    result["primary_parse_ns"] = frame->published_monotonic_ns-frame->received_monotonic_ns;
+    result["parse_errors"] = frameParseErrors.load();
+    result["callback_last_complete_ns"] = callbackTotalNs.load();
+    result["callback_tail_ns"] = callbackTailNs.load();
