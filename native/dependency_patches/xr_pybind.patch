+#pragma once
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <atomic>
+
+struct XrFrame {
+    std::array<double, 7> left{}, right{}, headset{};
+    std::array<double, 4> keys{}; // left grip/trigger, right grip/trigger
+    std::array<bool, 4> buttons{}; // X,Y,A,B
+    int64_t source_stamp_ns{0}, received_monotonic_ns{0}, published_monotonic_ns{0};
+    std::array<int64_t, 3> pose_received_ns{}, pose_source_ns{}; // left, right, headset
+    std::array<bool, 3> pose_valid{};
+    std::array<uint64_t, 4> button_press_counts{};
+    uint64_t payload_hash{0};
+    uint64_t sequence{0};
+};
+
+class XrFrameCache {
+public:
+    void publish(XrFrame frame) {
+        std::atomic_store(&latest_, std::make_shared<const XrFrame>(std::move(frame)));
+    }
+    std::shared_ptr<const XrFrame> latest() const { return std::atomic_load(&latest_); }
+    void clear() { std::atomic_store(&latest_, std::shared_ptr<const XrFrame>{}); }
+private:
+    std::shared_ptr<const XrFrame> latest_;
+};
