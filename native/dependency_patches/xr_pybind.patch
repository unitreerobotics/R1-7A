+std::atomic<int64_t> callbackTotalNs{0}, callbackTailNs{0}, callbackMaxNs{0}, callbackLockWaitNs{0};
+std::atomic<uint64_t> callbackCount{0};
+struct CallbackTimer {
+    int64_t start, primaryEnd{0};
+    explicit CallbackTimer(int64_t ns): start(ns) {}
+    ~CallbackTimer() {
+        const auto end=steadyNowNs(), total=end-start;
+        callbackTotalNs=total;
+        callbackTailNs=primaryEnd ? end-primaryEnd : 0;
+        auto previous=callbackMaxNs.load();
+        while(total>previous && !callbackMaxNs.compare_exchange_weak(previous,total)) {}
+        ++callbackCount;
+    }
+};
+uint64_t payloadHash(const char* data) {
+    uint64_t hash=14695981039346656037ULL;
+    const auto size=std::strlen(data);
+    for(size_t i=0;i<size;++i) {
+        hash^=static_cast<unsigned char>(data[i]);hash*=1099511628211ULL;
+    }
+    return hash;
+}
+bool validPose(const std::array<double,7>& pose) {
+    double norm=0.;
+    for(size_t i=0;i<pose.size();++i) {
+        if(!std::isfinite(pose[i])) return false;
+        if(i>=3) norm+=pose[i]*pose[i];
+    }
+    return norm>1e-10;
+}
