+void ArmMotorBus::stepJoint(int joint, const ArmJointCmd& cmd) {
+    if (!isOpen() || joint < 0 || joint >= kArmJointCount) {
+        return;
+    }
+
+    const auto& cal = impl_->calib[joint];
+    try {
+        std::vector<uint8_t> packet;
+        if (cmd.timed_out) {
+            packet = impl_->protocol.buildControlPacket(
+                impl_->motor_ids[joint], /*mode=*/1, /*timeout=*/true,
+                0.f, 0.f, 0.f, 0.f, 0.f);
+        } else {
+            const uint8_t mode = (cmd.mode == 0) ? 0 : 1;
+            const float motor_q = urdfToMotorAngle(cmd.q, cal);
+            const float motor_dq = urdfToMotorVec(cmd.dq, cal);
+            const float motor_tau = urdfToMotorVec(cmd.tau, cal);
+            packet = impl_->protocol.buildControlPacket(
+                impl_->motor_ids[joint], mode, /*timeout=*/(mode == 1),
+                motor_tau, motor_dq, motor_q, cmd.kp, cmd.kd);
+        }
+        impl_->writeAndWaitForReply(joint, packet);
+    } catch (const std::exception& e) {
+        std::cerr << "[ArmMotorBus] write joint " << joint
+                  << " failed: " << e.what() << std::endl;
+    }
+}
